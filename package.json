{
    "name": "bookmark-first",
    "version": "0.4.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check \"src/**/*.ts\" \"*.mjs\"",
        "format": "prettier --write \"src/**/*.ts\" \"*.mjs\"",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chrome": "^0.0.280",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^9.1.2",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    }
}
